# TransitOps Web — API configuration
#
# IMPORTANT (Cloudflare Pages):
# Production builds IGNORE VITE_API_URL and always call
# https://web-production-f8ec21.up.railway.app/api
# Do NOT set VITE_API_URL to transitops-backend-production.up.railway.app
# (that Railway app is decommissioned and causes CORS / Failed to fetch).
# Prefer deleting VITE_API_URL from Pages → Settings → Environment variables.
#
# Local / staging override (dev only):
# VITE_API_URL=https://web-production-f8ec21.up.railway.app/api

# Local Vite proxy target (optional). Defaults to the live Railway API.
# VITE_PROXY_TARGET=https://web-production-f8ec21.up.railway.app
