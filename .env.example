# TransitOps Web — API configuration
# Production (Cloudflare Pages): set in Pages → Environment variables
VITE_API_URL=https://web-production-f8ec21.up.railway.app/api

# Local Vite proxy target (optional). Default is http://localhost:8080
# VITE_PROXY_TARGET=https://web-production-f8ec21.up.railway.app

# Map tiles — plain OpenStreetMap raster tiles, no API key needed

# OpenRouteService / HeiGIT (https://openrouteservice.org) — campus routing
# Requests go to https://api.heigit.org/openrouteservice (legacy api.openrouteservice.org is deprecated)
VITE_ORS_API_KEY=
